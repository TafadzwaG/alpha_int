{
   "action": {
      "default_popup": "popup.html"
   },
   "author": "HyperWrite",
   "background": {
      "service_worker": "background.bundle.js"
   },
   "content_scripts": [ {
      "js": [ "googleDocsUtil.bundle.js", "googleDocsInject.bundle.js" ],
      "matches": [ "https://docs.google.com/document/d/*" ],
      "run_at": "document_idle"
   }, {
      "all_frames": false,
      "js": [ "googleDocsCanvasInjector.bundle.js" ],
      "matches": [ "https://docs.google.com/document/*" ],
      "run_at": "document_start"
   }, {
      "all_frames": false,
      "js": [ "extensionInstalled.bundle.js" ],
      "matches": [ "https://app.hyperwriteai.com/*", "https://hyperwriteai.com/*", "http://localhost:3000/*" ],
      "run_at": "document_idle"
   }, {
      "all_frames": true,
      "js": [ "app.bundle.js" ],
      "matches": [ "https://word.cloud.microsoft/*", "https://word-edit.officeapps.live.com/*" ],
      "run_at": "document_idle"
   }, {
      "all_frames": false,
      "exclude_matches": [ "https://auth.hyperwriteai.com/*", "http://localhost:3000/*", "https://accounts.google.com/*" ],
      "js": [ "app.bundle.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_idle"
   }, {
      "all_frames": false,
      "js": [ "eventTrap.bundle.js" ],
      "matches": [ "\u003Call_urls>" ]
   } ],
   "description": "Smart autocomplete for Gmail, Google Docs, ChatGPT, and more. An AI writing assistant that predicts words and sentences.",
   "externally_connectable": {
      "matches": [ "https://app.hyperwriteai.com/*", "https://hyperwriteai.com/*", "http://localhost:3000/*", "http://localhost:3001/*" ]
   },
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "icon128.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "HyperWrite: AI Writing Assistant and Autocomplete App",
   "options_ui": {
      "open_in_tab": true,
      "page": "settings.html"
   },
   "permissions": [ "storage", "tabs" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "4.2.7.3",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "content/inject.js", "*.png", "*.svg", "*.gif", "*.woff", "*.tff", "content/gDocsAnnotatedCanvas.js" ]
   } ]
}
